{
  "name": "geoptimize",
  "version": "0.7.0",
  "description": "Deterministic content-readiness lint for static websites and documentation",
  "type": "module",
  "main": "./dist/core/index.js",
  "bin": {
    "geoptimize": "dist/cli/index.js",
    "geo": "dist/cli/index.js",
    "geo-cli": "dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/core/index.js",
    "./vite": "./dist/plugins/vite.js",
    "./next": "./dist/plugins/next.js"
  },
  "files": [
    "dist/",
    "skills/",
    "agents/",
    "fixtures/",
    "examples/github-action-sample/",
    "scripts/verify-release-candidate.sh",
    "scripts/verify-publish-source.sh",
    "scripts/verify-release-v0.6.sh",
    ".claude-plugin/",
    "docs/methodology.md",
    "docs/release-v0.6.md",
    "docs/release-v0.7.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "ROADMAP.md",
    "SECURITY.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "check": "npm test && npm run build",
    "release:check": "bash scripts/verify-release-candidate.sh",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run release:check && bash scripts/verify-publish-source.sh"
  },
  "keywords": [
    "geo",
    "seo",
    "ai-search",
    "llms-txt",
    "structured-data",
    "json-ld",
    "generative-engine-optimization",
    "claude-code-skill",
    "vite-plugin",
    "nextjs-plugin"
  ],
  "homepage": "https://github.com/cucuwang/geoptimize",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cucuwang/geoptimize.git"
  },
  "bugs": {
    "url": "https://github.com/cucuwang/geoptimize/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "puppeteer-core": "^25.7.0",
    "cheerio": "^1.2.0",
    "commander": "^12.0.0",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  }
}
